{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(html|css|js|json|png|ico)",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none';"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/cv",
        "function": "serve_cv"
      },
      {
        "source": "/cv/**",
        "function": "serve_cv"
      },
      {
        "source": "/hero-blog",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      },
      {
        "source": "/hero-blog/**",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
