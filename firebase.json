{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".firebase/**",
      "run-local.sh",
      "stop.sh",
      "upload-2-prod.sh",
      ".claude/**"
    ],
    "rewrites": [
      {
        "source": "/hero-blog",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      },
      {
        "source": "/hero-blog/**",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      }
    ]
  }
}
