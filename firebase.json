{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/cv",
        "function": "serve_cv"
      },
      {
        "source": "/cv/**",
        "function": "serve_cv"
      },
      {
        "source": "/hero-blog",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      },
      {
        "source": "/hero-blog/**",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
