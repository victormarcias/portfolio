{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".firebase/**",
      "run-local.sh",
      "stop.sh",
      "upload-2-prod.sh",
      ".claude/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/cv",
        "function": "serve_cv"
      },
      {
        "source": "/cv/**",
        "function": "serve_cv"
      },
      {
        "source": "/hero-blog",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      },
      {
        "source": "/hero-blog/**",
        "run": {
          "serviceId": "fastapi-service",
          "region": "us-east4"
        }
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
