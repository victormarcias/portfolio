# Copy to .env (gitignored) and fill in real values. `firebase deploy --only
# functions` reads .env at deploy time, so re-deploy after changing it.

# Cloud Storage bucket where update_cv stores cv/cv.pdf
CV_BUCKET_NAME=your-project.firebasestorage.app

# Google Doc ID of the CV (the long id in docs.google.com/document/d/<ID>/edit);
# the Doc must stay shared as "anyone with the link can view"
CV_DOC_ID=your-google-doc-id
